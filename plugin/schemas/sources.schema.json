{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cr:sources",
  "title": "Registre des sources citées (references/sources.yaml)",
  "type": "object",
  "required": ["version_schema", "sources"],
  "additionalProperties": false,
  "properties": {
    "version_schema": { "const": 1 },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "titre", "editeur", "type", "droits", "statut"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "cr:communs#/$defs/identifiant" },
          "titre": { "type": "string" },
          "editeur": { "type": "string" },
          "auteurs": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "publie_le": { "type": "string", "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$" },
          "consulte_le": { "$ref": "cr:communs#/$defs/date" },
          "type": { "enum": ["ffr", "world-rugby", "litterature", "outil", "club"] },
          "droits": { "type": "string" },
          "statut": {
            "description": "consultee : lue à la date indiquée ; a-verifier : référence connue, non relue pour ce projet.",
            "enum": ["consultee", "a-verifier"]
          },
          "note": { "type": "string" }
        }
      }
    }
  }
}
